page {
  background: #f1f5f9;
  color: #0f172a;
  font-size: 28rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.06);
}

.btn-primary {
  background: #5b5ce2;
  color: #fff;
  border-radius: 12rpx;
}

.btn-ghost {
  background: #fff;
  color: #5b5ce2;
  border: 1rpx solid #5b5ce2;
  border-radius: 12rpx;
}

.muted {
  color: #64748b;
  font-size: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.field-label {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.empty {
  text-align: center;
  color: #94a3b8;
  padding: 80rpx 0;
}
