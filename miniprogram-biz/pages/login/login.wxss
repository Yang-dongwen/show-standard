.wrap {
  min-height: 100vh;
  background: linear-gradient(160deg, #0f172a, #312e81);
  padding: 80rpx 32rpx 40rpx;
}
.brand {
  text-align: center;
  color: #fff;
  margin-bottom: 48rpx;
}
.logo {
  width: 100rpx;
  height: 100rpx;
  line-height: 100rpx;
  margin: 0 auto 20rpx;
  border-radius: 24rpx;
  background: #5b5ce2;
  font-size: 48rpx;
  font-weight: 700;
}
.title {
  font-size: 40rpx;
  font-weight: 700;
}
.sub {
  margin-top: 12rpx;
  color: #94a3b8;
  font-size: 24rpx;
}
.card {
  margin: 0;
}
.tip {
  margin-top: 20rpx;
  text-align: center;
}
.bind-tip {
  background: #fef3c7;
  color: #92400e;
  padding: 16rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
}
button {
  margin-top: 12rpx;
}
.btn-wx {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
}
