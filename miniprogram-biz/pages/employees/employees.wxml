<view class="card">
  <view class="field">
    <view class="field-label">新增员工</view>
    <input placeholder="姓名" value="{{name}}" bindinput="onName" />
  </view>
  <button class="btn-primary" bindtap="add">添加</button>
</view>
<view class="card item" wx:for="{{items}}" wx:key="id">
  <view class="row">
    <view>{{item.name}}</view>
    <view class="muted">{{item.status === 'active' ? '在岗' : '停用'}}</view>
  </view>
</view>
