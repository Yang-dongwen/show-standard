<view class="card">
  <view class="field">
    <view class="field-label">服务名</view>
    <input value="{{name}}" data-k="name" bindinput="onField" />
  </view>
  <view class="field">
    <view class="field-label">价格</view>
    <input type="digit" value="{{price}}" data-k="price" bindinput="onField" />
  </view>
  <button class="btn-primary" bindtap="add">新增服务</button>
</view>
<view class="card item" wx:for="{{items}}" wx:key="id">
  <view class="row">
    <view>{{item.name}}</view>
    <view>¥{{item.price}}</view>
  </view>
</view>
