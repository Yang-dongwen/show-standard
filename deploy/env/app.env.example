# =============================================================================
# show-standard 环境变量模板（可提交 Git）
# -----------------------------------------------------------------------------
# 用法:
#   1) 复制为 deploy/env/app.env（已 gitignore），填入真实值
#   2) 本机同步到服务器: deploy/scripts/sync-env-local.ps1
#   3) Docker:
#        docker compose -f deploy/stack/compose.lite.yml --env-file deploy/env/app.env up -d
#
# 切勿把含真实密钥的 app.env 提交到 Git 或 GitHub Actions Secrets
# 生产配置绑定: src/main/resources/application-ec2.yml（仅 ${ENV} 占位）
# =============================================================================

# ---------- 云端 MySQL（AWS RDS）----------
# 将 YOUR_RDS_ENDPOINT 换成 RDS 终端节点（不要含端口）
SPRING_DATASOURCE_URL=jdbc:mysql://YOUR_RDS_ENDPOINT:3306/show?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=true&requireSSL=true&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# init-rds.sh 用（与上面账号一致即可）
RDS_HOST=YOUR_RDS_ENDPOINT
RDS_PORT=3306
RDS_DATABASE=show
DB_USER=
DB_PASSWORD=

# ---------- JWT / 租户 AES（多实例必须固定，勿留空让每台随机）----------
# 生成示例:
#   openssl rand -hex 48   → APP_JWT_SECRET
#   openssl rand -hex 32   → APP_JWT_TENANT_AES_KEY
APP_JWT_SECRET=
APP_JWT_TENANT_AES_KEY=
# 可选: JWT 过期分钟数（默认 720）
# APP_JWT_EXPIRE_MINUTES=720

# ---------- 安全（生产建议 true；CloudSecurityGuard 失败即关）----------
APP_SECURITY_STRICT_CLOUD=true

# ---------- SaaS 运营台 bootstrap（仅首次建平台管理员）----------
# 首次启动可 true + 强密码；验收后务必改为 false，并轮换密码
APP_SAAS_BOOTSTRAP_ENABLED=true
APP_SAAS_BOOTSTRAP_USERNAME=platform
APP_SAAS_BOOTSTRAP_PASSWORD=CHANGE_ME

# SaaS / C 端邀请码（按需）
APP_SAAS_INVITE_CODE=
APP_REGISTER_INVITE_CODE=

# ---------- 微信小程序（生产关闭 mock；无密钥时保持 enabled=false）----------
APP_WX_MINIAPP_ENABLED=false
APP_WX_MINIAPP_MOCK=false
APP_WX_MINIAPP_APP_ID=
APP_WX_MINIAPP_APP_SECRET=

# ---------- 宿主机端口 / JVM / 数据目录 ----------
# nginx 映射: 宿主机 APP_HOST_PORT → 容器 80 → app:8080
APP_HOST_PORT=8090
JAVA_OPTS="-Xms256m -Xmx512m"
HOST_DATA_ROOT=/data/show-standard

# 可选: 备份目录（容器内默认 /root/.show/backups，经 volume 持久化）
# APP_BACKUP_DIR=/root/.show/backups
