# =============================================================================
# 可选：本机 env 方式（多数情况更推荐 application-cloud.yml + 本地 MySQL）
# -----------------------------------------------------------------------------
# 复制为 deploy/env/app.env.local（gitignore）后按需填写。
# 本文件仅作本地联调参考，不会用于 EC2 生产同步。
# =============================================================================

SPRING_PROFILES_ACTIVE=cloud
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/show?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# 本地可放宽；生产见 app.env.example
APP_SECURITY_STRICT_CLOUD=false
APP_SAAS_BOOTSTRAP_ENABLED=true
APP_SAAS_BOOTSTRAP_USERNAME=platform
APP_SAAS_BOOTSTRAP_PASSWORD=

# 本地 JWT（勿用生产密钥）
APP_JWT_SECRET=
APP_JWT_TENANT_AES_KEY=

APP_WX_MINIAPP_ENABLED=false
APP_WX_MINIAPP_MOCK=true
