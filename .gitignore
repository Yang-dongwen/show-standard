# IDE / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# Node dependencies (install under frontend/ or frontend-saas/)
node_modules/

# Root-level npm mistake — real apps live under frontend/ and frontend-saas/
# Do not run npm install at repo root.
/package.json
/package-lock.json

# Maven
target/
*.class
hs_err_pid*
replay_pid*

# Desktop packaging outputs (jlink / jpackage)
/build/
/dist/
*.msi

# Logs / local runtime data
*.log
logs/
*.db
*.db-journal
*.sqlite
*.sqlite3

# Env / secrets
.env
.env.*
!.env.example
*.local

# 部署密钥（切勿提交）— 仅 env/ 下真实文件；application-ec2.yml 要提交（变量占位）
deploy/env/app.env
deploy/env/app.env.local
deploy/env/.env
deploy/env/SECRETS_INVENTORY.env
deploy/env/.admin-once.txt
# 兼容旧路径
deploy/app.env
deploy/app.env.local
deploy/.env
deploy/SECRETS_INVENTORY.env
deploy/.admin-once.txt
!deploy/env/app.env.example
!deploy/env/app.env.local.example

# Frontend local caches (build output goes to src/main/resources/static)
frontend/dist/
frontend-saas/dist/
.vite/
*.tsbuildinfo

# Test / coverage
coverage/
.nyc_output/

# Local scratch / temp API dumps (do not commit)
tmp_api/
tmp/
temp/
*.tmp

# Optional OS junk
$RECYCLE.BIN/
*.swp
*~

# Grok agent local state
.grok/

